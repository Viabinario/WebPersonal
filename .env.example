# ============================================
# Formulario de contacto (Resend)
# ============================================
# URL del endpoint que envía el email (ej: tu API en Vercel).
# Obtén esta URL después de desplegar api/contact en Vercel.
VITE_CONTACT_API_URL=https://tu-proyecto.vercel.app/api/contact

# ============================================
# Variables del backend (Vercel / servidor)
# NO poner en el frontend. Configurar en Vercel > Project > Settings > Environment Variables.
# ============================================
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Contacto <onboarding@resend.dev>
# RESEND_TO_EMAIL=tu-email@ejemplo.com
