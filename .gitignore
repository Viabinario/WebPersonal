# ============================================
# NOTAS IMPORTANTES
# ============================================

# IMPORTANTE: Si el archivo src/utils/supabase/info.tsx contiene
# credenciales sensibles (projectId, publicAnonKey), considera:
# 1. Mover las credenciales a variables de entorno (.env)
# 2. Agregar info.tsx al .gitignore
# 3. Crear un archivo info.example.tsx con valores de ejemplo

# Para usar variables de entorno, crear un archivo .env.example:
# SUPABASE_PROJECT_ID=your_project_id_here
# SUPABASE_PUBLIC_ANON_KEY=your_anon_key_here
