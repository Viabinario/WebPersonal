# Excluir archivos .js compilados, pero permitir archivos SVG generados en imports
*.js
!src/imports/*.js  # Mantener archivos SVG generados
!docs/**/*.js  # Permitir archivos JS del build para GitHub Pages
*.d.ts
!src/**/*.d.ts

